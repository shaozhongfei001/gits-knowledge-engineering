# Staging环境配置模板 — 复制为 .env.staging 并填写真实值
# cp .env.staging.template .env.staging

# === MySQL ===
MYSQL_DATABASE=gits_kno
MYSQL_USER=ontos
MYSQL_PASSWORD=           # 必填: MySQL用户密码
MYSQL_ROOT_PASSWORD=      # 必填: MySQL root密码

# === Oracle (可选) ===
ORACLE_SOURCE_ENABLED=false
ORACLE_JDBC_URL=          # 如: jdbc:oracle:thin:@//host:1521/service
ORACLE_USER=              # Oracle用户名
ORACLE_PASSWORD=          # Oracle密码

# === LLM ===
LLM_MODE=real
LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=              # 必填: OpenAI API Key (当LLM_MODE=real时)
LLM_MODEL=gpt-4o-mini

# === CRM ===
CRM_MODE=http
CRM_BASE_URL=             # CRM回写URL (当CRM_MODE=http时)
CRM_AUTH_TOKEN=           # CRM认证令牌

# === 安全 ===
API_KEY=                  # API访问密钥
CORS_ALLOWED_ORIGINS=*

# === 端口 ===
API_PORT=8080
WORKER_PORT=8090
NGINX_PORT=80
MYSQL_PORT=3306
ZIPKIN_PORT=9411
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# === 可观测性 ===
TRACE_SAMPLING=0.5
GRAFANA_ADMIN_PASSWORD=admin
