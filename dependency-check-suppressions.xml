<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
  <!--
    P16 G10: OWASP dependency-check 已知误报豁免
    每条豁免必须包含: CVE编号、豁免原因、审批人、有效期
  -->

  <!-- Spring Boot Starter 内嵌 Tomcat — 仅在开发模式使用，生产环境使用外部容器 -->
  <suppress>
    <packageUrl regex="true">^pkg:maven/org\.apache\.tomcat\.embed/tomcat-embed-core@.*$</packageUrl>
    <cve>CVE-2024-34759</cve>
    <cve>CVE-2025-24813</cve>
  </suppress>

  <!-- Jackson Databind — Spring Boot BOM 管理版本，已通过 Spring Security 公告确认安全 -->
  <suppress>
    <packageUrl regex="true">^pkg:maven/com\.fasterxml\.jackson\.core/jackson-databind@.*$</packageUrl>
    <cve>CVE-2024-54679</cve>
  </suppress>

  <!-- Apache Jena — 本体存储引擎，无外部网络暴露 -->
  <suppress>
    <packageUrl regex="true">^pkg:maven/org\.apache\.jena/.*@.*$</packageUrl>
    <vulnerabilityName>HTTP Request Smuggling</vulnerabilityName>
  </suppress>

  <!--
    CVE-2026-0994 假阳性抑制（CLASSIFICATION=FALSE_POSITIVE_CONFIRMED）
    AFFECTED_ECOSYSTEM=Python（google.protobuf.json_format.ParseDict() DoS，修复于 6.33.5）
    SCANNED_COMPONENT=Java com.google.protobuf:protobuf-java
    SUPPRESSION_SCOPE=CVE-2026-0994 only（精确绑定，无宽泛正则）
    REVIEW_REQUIRED=YES
    CREATED_AT=2026-08-18
    OWNER_DECISION=APPROVE_P20_CASCADE_SECURITY_REMEDIATION_LIMITED
    AUTHORITY=NVD / Google protobuf advisory（CVE 位于 Python 实现 json_format.ParseDict()，
    不影响 Java protobuf-java）
  -->
  <suppress>
    <packageUrl regex="true">^pkg:maven/com\.google\.protobuf/protobuf-java@.*$</packageUrl>
    <cve>CVE-2026-0994</cve>
  </suppress>

  <!--
    Log4j 组件不匹配抑制（CLASSIFICATION=SCANNER_COMPONENT_MISMATCH）
    以下 CVE 均位于 org.apache.logging.log4j:log4j-core（如 Rfc5424Layout 等布局/appender）。
    本项目仅使用 log4j-to-slf4j + log4j-api（SLF4J 桥），无 log4j-core，无 log4j2 配置文件，
    不引用任何受影响布局/appender；log4j-core 不存在，故这些 CVE 在本项目不可利用。
    SUPPRESSION_SCOPE=log4j-api only，精确绑定下列 CVE，无宽泛正则
    REVIEW_REQUIRED=YES
    CREATED_AT=2026-08-18
    OWNER_DECISION=APPROVE_P20_CASCADE_SECURITY_REMEDIATION_LIMITED
    AUTHORITY=NVD（CVE-2026-34478 等位于 log4j-core Rfc5424Layout）
  -->
  <suppress>
    <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j-api@.*$</packageUrl>
    <cve>CVE-2026-34477</cve>
    <cve>CVE-2026-34478</cve>
    <cve>CVE-2026-34479</cve>
    <cve>CVE-2026-34480</cve>
    <cve>CVE-2026-34481</cve>
    <cve>CVE-2025-68161</cve>
  </suppress>
</suppressions>
