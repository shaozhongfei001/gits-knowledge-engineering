# 生产环境配置模板 — 复制为 .env.prod 并填写真实值
# cp .env.prod.template .env.prod
# ⚠️ 此文件包含敏感信息，切勿提交到版本控制

# === MySQL ===
MYSQL_DATABASE=gits_kno
MYSQL_USER=                  # 必填: 生产MySQL用户
MYSQL_PASSWORD=              # 必填: 生产MySQL密码
MYSQL_ROOT_PASSWORD=         # 必填: MySQL root密码
MYSQL_URL=jdbc:mysql://mysql:3306/gits_kno?useSSL=true&allowPublicKeyRetrieval=true

# === Oracle (可选) ===
ORACLE_SOURCE_ENABLED=false
ORACLE_JDBC_URL=             # 如: jdbc:oracle:thin:@//host:1521/service
ORACLE_USER=                 # Oracle用户名
ORACLE_PASSWORD=             # Oracle密码
ORACLE_POLL_INTERVAL=120s

# === LLM ===
LLM_MODE=real
LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=                 # 必填: LLM API密钥
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60
LLM_RETRY_MAX_ATTEMPTS=3
LLM_CB_FAILURE_THRESHOLD=5
LLM_CB_HALF_OPEN_DELAY_MS=60000

# === CRM ===
CRM_MODE=http
CRM_BASE_URL=                # 必填: CRM回写URL
CRM_AUTH_TOKEN=              # CRM认证令牌
CRM_TIMEOUT=30
CRM_RETRY_MAX_ATTEMPTS=3

# === 安全 (生产环境必须配置) ===
API_KEY=                     # 必填: API访问密钥
API_KEY_ROTATION=            # 轮转Key
API_KEY_ROTATION_DEADLINE=   # 轮转截止时间 (ISO 8601)
CORS_ALLOWED_ORIGINS=        # 必填: 允许的前端域名，逗号分隔

# === 连接池 ===
HIKARI_MAX_POOL=20
HIKARI_MIN_IDLE=5
HIKARI_IDLE_TIMEOUT=600000
HIKARI_CONN_TIMEOUT=30000
HIKARI_MAX_LIFETIME=1800000
HIKARI_LEAK_DETECTION=30000

# === Tomcat ===
TOMCAT_MAX_THREADS=200
TOMCAT_MIN_SPARE_THREADS=10
TOMCAT_MAX_CONNECTIONS=8192
TOMCAT_ACCEPT_COUNT=100

# === 端口 ===
API_PORT=8080
WORKER_PORT=8090
NGINX_PORT=80
MYSQL_PORT=3306
ZIPKIN_PORT=9411
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# === 可观测性 ===
TRACE_SAMPLING=0.1
ZIPKIN_URL=http://zipkin:9411/api/v2/spans
GRAFANA_ADMIN_PASSWORD=      # 必填: Grafana管理员密码

# === 日志 ===
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APP=INFO
LOG_FILE=/var/log/gits-kno/api.log
LOG_MAX_FILE_SIZE=100MB
LOG_MAX_HISTORY=30
LOG_TOTAL_SIZE_CAP=3GB
