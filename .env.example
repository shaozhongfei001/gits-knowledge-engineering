# GITS Knowledge Engineering — Environment Template
# Copy to a file OUTSIDE the repository (e.g. ~/.local_database.env) and fill
# local values. Do NOT commit real env files; scripts/secret_scan.py enforces
# this. Values below use "<...>" placeholders so they pass the secret scan.

# ========== MYSQL数据库配置 (gits_ke 管理库) ==========
GITS_KEDB_TYPE=mysql
GITS_KEDB_HOST=localhost
GITS_KEDB_PORT=3306
GITS_KEDB_NAME=gits_ke
GITS_KEDB_USER=<db_user>
GITS_KEDB_PASSWORD=<set outside the repository>

# ========== 审计日志配置 ==========
GITS_AUDIT_ENABLED=true
GITS_AUDIT_RETENTION_DAYS=90

# ========== 加密配置 ==========
GITS_ENCRYPTION_KEY=<set outside the repository>

# ========== 可观测性配置 ==========
GITS_OBSERVABILITY_ENABLED=true

# ========== Oracle EDwCRM (分析数据源) ==========
# Oracle remains QUARANTINED (STATUS.md: ORACLE_INTEGRATION=QUARANTINED_NOT_AUTHORIZED).
# Do NOT enable without an approved ADR + data-owner authorization + a dedicated loop.
GITS_ORACLE_HOST=<oracle_host>
GITS_ORACLE_PORT=1521
GITS_ORACLE_SERVICE=<oracle_service>
GITS_ORACLE_USER=<oracle_user>
GITS_ORACLE_PASSWORD=<oracle_password>

# Optional: disposable local MySQL container (compose.local.yaml, profile local-db).
# Only needed when spinning up a fresh container, not for the existing host MySQL.
# GITS_KEDB_ROOT_PASSWORD=<set outside the repository when using compose>
