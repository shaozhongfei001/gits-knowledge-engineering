{
  "$id": "https://gientech.com/gits/kno/schemas/knowledge-element.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "知识要素（KE）合同。以《银行知识工程规范打样_fixed.xlsx》4.4 为准：知识要素是知识条目（KI）下的原子要素，按生产方式分类（K-Type-F/R/P/E/M）。",
  "properties": {
    "content": {
      "minLength": 1,
      "type": "string"
    },
    "elementId": {
      "pattern": "^KE-[A-Z0-9-]+-\\d{2}$",
      "type": "string"
    },
    "kind": {
      "enum": [
        "K-Type-F",
        "K-Type-R",
        "K-Type-P",
        "K-Type-E",
        "K-Type-M",
        "K-Type-F/R"
      ],
      "type": "string"
    },
    "knowledgeItemId": {
      "pattern": "^KI-[A-Z0-9-]+$",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "relatedRules": {
      "items": {
        "pattern": "^RUL-",
        "type": "string"
      },
      "type": "array"
    },
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "enum": [
            "AUTHORITATIVE",
            "REFERENCE",
            "DERIVED",
            "SYNTHETIC"
          ],
          "type": "string"
        },
        "sourceRef": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "sourceRef",
        "authority"
      ],
      "type": "object"
    },
    "status": {
      "enum": [
        "DRAFT",
        "VALIDATION",
        "ACTIVE",
        "RETIRED"
      ],
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "elementId",
    "name",
    "kind",
    "knowledgeItemId",
    "content",
    "source",
    "status"
  ],
  "title": "GITS Atomic Knowledge Element",
  "type": "object"
}
