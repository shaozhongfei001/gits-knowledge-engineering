{
  "components": {
    "responses": {
      "Problem": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "RFC 9457 problem detail"
      }
    },
    "schemas": {
      "ArchitectureStatus": {
        "additionalProperties": false,
        "properties": {
          "frozen": {
            "const": false,
            "type": "boolean"
          },
          "packageId": {
            "const": "HZB-KNO-DEV-PACKAGE-V0.1",
            "type": "string"
          },
          "productionReady": {
            "const": false,
            "type": "boolean"
          },
          "state": {
            "enum": [
              "DEV_PACKAGE_CANDIDATE"
            ],
            "type": "string"
          }
        },
        "required": [
          "packageId",
          "state",
          "productionReady",
          "frozen"
        ],
        "type": "object"
      },
      "Problem": {
        "properties": {
          "detail": {
            "type": "string"
          },
          "status": {
            "maximum": 599,
            "minimum": 400,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "type": {
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "traceId"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "工程候选API；不代表真实外部系统已经接通。",
    "title": "HZB Knowledge Engineering API",
    "version": "0.1.0"
  },
  "openapi": "3.1.1",
  "paths": {
    "/architecture/status": {
      "get": {
        "operationId": "getArchitectureStatus",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArchitectureStatus"
                }
              }
            },
            "description": "Current declared status"
          }
        },
        "summary": "Return the declared engineering package status"
      }
    }
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ]
}
