@prefix hzb: <https://gientech.com/hzb/kno/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

hzb:CoreOntology a owl:Ontology ;
  rdfs:label "杭州银行知识工程运行本体核心"@zh .

hzb:OperatingCase a owl:Class .
hzb:Interaction a owl:Class ; rdfs:subClassOf prov:Activity .
hzb:Claim a owl:Class ; rdfs:subClassOf prov:Entity .
hzb:Evidence a owl:Class ; rdfs:subClassOf prov:Entity .
hzb:HumanConfirmation a owl:Class ; rdfs:subClassOf prov:Activity .
hzb:Action a owl:Class ; rdfs:subClassOf prov:Activity .
hzb:Receipt a owl:Class ; rdfs:subClassOf prov:Entity .
hzb:Evaluation a owl:Class ; rdfs:subClassOf prov:Activity .

hzb:belongsToCase a owl:ObjectProperty ;
  rdfs:range hzb:OperatingCase .

hzb:supportedBy a owl:ObjectProperty ;
  rdfs:domain hzb:Claim ;
  rdfs:range hzb:Evidence .

hzb:authorizedBy a owl:ObjectProperty ;
  rdfs:domain hzb:Action ;
  rdfs:range hzb:HumanConfirmation .

hzb:producedReceipt a owl:ObjectProperty ;
  rdfs:domain hzb:Action ;
  rdfs:range hzb:Receipt .
