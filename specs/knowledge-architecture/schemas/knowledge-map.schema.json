{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gientech.com/gits/kno/schemas/knowledge-map.json",
  "title": "GITS Knowledge Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mapId", "name", "version", "status", "mapType", "entrypoints", "domains", "defaultPolicy", "routePolicyRef"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "mapId": {"type": "string", "pattern": "^KM-[A-Z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["DRAFT", "VALIDATION", "ACTIVE", "RETIRED"]},
    "mapType": {"type": "string", "enum": ["ROOT", "DOMAIN", "TASK"]},
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "tasks"],
      "properties": {
        "roles": {"type": "array", "items": {"type": "string"}},
        "tasks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domainId", "name", "purpose", "mapRef"],
        "properties": {
          "domainId": {"type": "string"},
          "name": {"type": "string"},
          "purpose": {"type": "string"},
          "mapRef": {"type": "string"}
        }
      }
    },
    "assetRefs": {"type": "array", "items": {"type": "string"}},
    "skillRefs": {"type": "array", "items": {"type": "string"}},
    "activationContractRefs": {"type": "array", "items": {"type": "string"}},
    "routePolicyRef": {"type": "string", "minLength": 1},
    "defaultPolicy": {"type": "string", "const": "DENY"},
    "maxInitialTokens": {"type": "integer", "minimum": 256, "maximum": 4096}
  }
}
