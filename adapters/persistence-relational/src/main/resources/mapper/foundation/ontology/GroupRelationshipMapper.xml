<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gien.gits.adapter.persistence.foundation.ontology.mapper.GroupRelationshipMapper">

    <resultMap id="groupRelationshipRowResultMap"
               type="com.gien.gits.adapter.persistence.foundation.ontology.dto.GroupRelationshipRow">
            <constructor>
                <idArg column="id" javaType="java.util.UUID"/>
                <arg column="group_id" javaType="String"/>
                <arg column="from_entity_id" javaType="String"/>
                <arg column="to_entity_id" javaType="String"/>
                <arg column="relationship_type" javaType="String"/>
                <arg column="ownership_ratio" javaType="Integer"/>
                <arg column="created_at" javaType="java.time.Instant"
                    typeHandler="com.gien.gits.adapter.persistence.common.typehandler.InstantTypeHandler"/>
            </constructor>
    </resultMap>

    <insert id="insert" parameterType="com.gien.gits.ontology.GroupRelationship">
        INSERT INTO group_relationship (id, group_id, from_entity_id, to_entity_id,
                                        relationship_type, ownership_ratio, created_at)
        VALUES (#{id}, #{groupId}, #{fromEntityId}, #{toEntityId},
                #{relationshipType}, #{ownershipRatio},
                #{createdAt, typeHandler=com.gien.gits.adapter.persistence.common.typehandler.InstantTypeHandler})
    </insert>

    <select id="findRowsByGroupId" resultMap="groupRelationshipRowResultMap">
        SELECT id, group_id, from_entity_id, to_entity_id, relationship_type, ownership_ratio, created_at
        FROM group_relationship
        WHERE group_id = #{groupId}
    </select>

</mapper>
