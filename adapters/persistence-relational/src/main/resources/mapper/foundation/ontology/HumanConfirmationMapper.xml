<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gien.gits.adapter.persistence.foundation.ontology.mapper.HumanConfirmationMapper">

    <resultMap id="humanConfirmationResult" type="com.gien.gits.ontology.HumanConfirmation">
            <constructor>
                <idArg column="confirmation_id" javaType="java.util.UUID"/>
                <arg column="action_id" javaType="String"/>
                <arg column="confirmed_by" javaType="String"/>
                <arg column="confirmed_at" javaType="java.time.Instant"
                    typeHandler="com.gien.gits.adapter.persistence.common.typehandler.InstantTypeHandler"/>
                <arg column="decision" javaType="String"/>
                <arg column="reason" javaType="String"/>
            </constructor>
</resultMap>

    <insert id="insert" parameterType="com.gien.gits.ontology.HumanConfirmation">
        INSERT INTO human_confirmation (
            confirmation_id, action_id, confirmed_by, confirmed_at, decision, reason
        ) VALUES (
            #{confirmationId}, #{actionId}, #{confirmedBy},
            #{confirmedAt, typeHandler=com.gien.gits.adapter.persistence.common.typehandler.InstantTypeHandler},
            #{decision}, #{reason}
        )
    </insert>

    <select id="findByConfirmationId" resultMap="humanConfirmationResult">
        SELECT confirmation_id, action_id, confirmed_by, confirmed_at, decision, reason
        FROM human_confirmation WHERE confirmation_id = #{confirmationId}
    </select>

</mapper>
